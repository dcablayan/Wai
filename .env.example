# Wai environment variables
# Copy to .env and fill in values. Never commit .env to git.

# NOAA CO-OPS API — no key required for public products
# (water_level, predictions, datums, metadata)
# See: https://api.tidesandcurrents.noaa.gov/api/prod/

# Hohonu API bearer token (required only for the live Hohonu adapter;
# offline tests use mock_hohonu_observations instead)
# HOHONU_API_KEY=

# Force offline mode for scripts.evaluate_noaa_public (writes mock reports
# instead of calling the live NOAA API)
# NOAA_OFFLINE=1
